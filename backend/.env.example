# Configuración del Agente de Gestión Ciudadana - Alcaldía de Barranquilla
APP_NAME="Agente de Gestión Ciudadana - Alcaldía de Barranquilla"
APP_ENV="development"
PORT=8000
HOST="0.0.0.0"

# Ollama LLM & Embeddings (Procesamiento 100% Local $0)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
LLM_MODEL="qwen2.5:0.5b"
LLM_FALLBACK_MODEL="phi3:latest"
EMBEDDING_MODEL="nomic-embed-text"

# Base de Datos (Snowflake Logical Architecture sobre SQLite Local)
DATABASE_URL="sqlite:///./data_barranquilla.db"
SNOWFLAKE_READY=true
SNOWFLAKE_ACCOUNT=""
SNOWFLAKE_USER=""
SNOWFLAKE_PASSWORD=""
SNOWFLAKE_DATABASE="BARRANQUILLA_CITIZEN_DB"
SNOWFLAKE_SCHEMA="OPERATIONS"
SNOWFLAKE_WAREHOUSE="COMPUTE_WH"

# Seguridad y Límites
MAX_RAG_RESULTS=4
CONFIDENCE_THRESHOLD=0.70
SANDBOX_MODE=true
