# =====================================================================
# ALCALDÍA DISTRITAL DE BARRANQUILLA — PLANTILLA DE CONFIGURACIÓN
# Copia este archivo como .env y completa tus credenciales
# =====================================================================

APP_NAME="Agente de Gestión Ciudadana - Alcaldía de Barranquilla"
APP_ENV="production"
PORT=8000
HOST="0.0.0.0"

# ---------------------------------------------------------------------
# Proveedores de Inteligencia Artificial (Groq Cloud + Ollama Local $0)
# ---------------------------------------------------------------------
# Obtén tu clave gratuita en https://console.groq.com
GROQ_API_KEY="tu_clave_groq_aqui"
GROQ_MODEL="openai/gpt-oss-120b"

# Ollama local para operación 100% desconectada y sin costo
OLLAMA_BASE_URL="http://127.0.0.1:11434"
LLM_MODEL="qwen2.5:0.5b"
LLM_FALLBACK_MODEL="llama3:latest"
EMBEDDING_MODEL="nomic-embed-text"

# ---------------------------------------------------------------------
# Base de Datos Relacional y Vectorial SQLite
# ---------------------------------------------------------------------
DATABASE_URL="sqlite:///./data_barranquilla.db"

# ---------------------------------------------------------------------
# Conexión Snowflake Cloud (Principio de Menor Privilegio)
# ---------------------------------------------------------------------
SNOWFLAKE_READY=true
SNOWFLAKE_ACCOUNT="tu_identificador_de_cuenta_snowflake"
SNOWFLAKE_USER="BQL_MCP_READER"
SNOWFLAKE_PASSWORD="tu_password_seguro"
SNOWFLAKE_ROLE="BQL_CITIZEN_READONLY_ROLE"
SNOWFLAKE_DATABASE="BARRANQUILLA_CITIZEN_DB"
SNOWFLAKE_SCHEMA="OPERATIONS"
SNOWFLAKE_WAREHOUSE="COMPUTE_WH"

# ---------------------------------------------------------------------
# Parámetros Operativos
# ---------------------------------------------------------------------
MAX_RAG_RESULTS=4
CONFIDENCE_THRESHOLD=0.70
SANDBOX_MODE=true
